# ==========================================
# HoneyMilk Cakes and Steeze
# Backend Environment Configuration
# ==========================================

APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com

# Database Configuration (MySQL 8+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=honeymilk_db
DB_USER=honeymilk_user
DB_PASSWORD=your_secure_db_password

# Authentication
JWT_SECRET=generate_a_random_32_character_secret_key_here

# Paystack Gateway (Nigerian Payment Gateway)
PAYSTACK_PUBLIC_KEY=pk_live_your_actual_public_key
PAYSTACK_SECRET_KEY=sk_live_your_actual_secret_key

# Mail Service (SMTP)
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@your-domain.com
MAIL_PASSWORD=your_mail_password
MAIL_FROM=concierge@honeymilksteeze.com
MAIL_FROM_NAME="HoneyMilk Cakes and Steeze"
